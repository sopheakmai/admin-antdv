{
  "name": "antdv-pro",
  "type": "module",
  "version": "1.3.2",
  "packageManager": "pnpm@10.14.0",
  "author": "aibayanyu <aibayanyu@qq.com>",
  "repository": "antdv-pro/antdv-pro",
  "engines": {
    "node": ">=18.15.0"
  },
  "scripts": {
    "dev": "mist --host",
    "build": "vue-tsc && mist build",
    "clear:vercel": "rm -rf ./vercel.json",
    "build:vercel": "run-s clear:vercel build:nitro",
    "build:nitro": "mist build nitro",
    "start:nirto": "node .output/server/index.mjs",
    "preview": "mist preview",
    "lint": "eslint src --fix",
    "typecheck": "vue-tsc --noEmit",
    "bump:patch": "changelogen --bump --output CHANGELOG.md --release",
    "bump:minor": "changelogen --bump --output CHANGELOG.md --release --minor",
    "bump:major": "changelogen --bump --output CHANGELOG.md --release --major",
    "prepare": "husky",
    "dir-tree": "esno ./scripts/dir-tree",
    "gen:uno": "esno ./scripts/gen-unocss",
    "toJS": "esno scripts/to-js"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@antv/g2plot": "^2.4.33",
    "@antv/l7": "^2.23.0",
    "@ctrl/tinycolor": "^4.1.0",
    "@v-c/utils": "^0.0.26",
    "@vueuse/core": "^13.6.0",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.11.0",
    "dayjs": "^1.11.13",
    "mitt": "^3.0.1",
    "pinia": "^3.0.3",
    "vue": "^3.5.18",
    "vue-i18n": "^11.1.11",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.2.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@mistjs/cli": "0.0.1-beta.9",
    "@mistjs/vite-plugin-preload": "^0.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.2.0",
    "@types/treeify": "^1.0.3",
    "@unocss/eslint-plugin": "^66.4.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitejs/plugin-vue-jsx": "^5.0.1",
    "@vue/test-utils": "^2.4.6",
    "antdv-component-resolver": "^1.0.7",
    "antdv-style": "0.0.1-beta.2",
    "changelogen": "^0.6.2",
    "cross-env": "^10.0.0",
    "directory-tree": "^3.5.2",
    "esbuild": "^0.25.8",
    "eslint": "^9.32.0",
    "esno": "^4.8.0",
    "execa": "^9.6.0",
    "fs-extra": "^11.3.1",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "less": "^4.4.0",
    "lint-staged": "^16.1.5",
    "lodash": "^4.17.21",
    "nitropack": "^2.12.4",
    "npm-run-all": "^4.1.5",
    "picocolors": "^1.1.1",
    "treeify": "^1.1.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2",
    "unocss": "^66.4.2",
    "unocss-preset-chinese": "^0.3.3",
    "unocss-preset-ease": "^0.0.4",
    "unplugin-auto-import": "^20.0.0",
    "unplugin-config": "^0.1.5",
    "unplugin-vue-components": "^29.0.0",
    "vite": "^7.1.1",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.5"
  },
  "lint-staged": {
    "**/*.{vue,ts,js,jsx,tsx}": "eslint src --fix"
  }
}
